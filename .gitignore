# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# local Sites/D1 state and retained preview logs
/.wrangler/
/.devserver*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal

# local agent settings
/.claude/settings.local.json

# 교사 평가 자료 (루브릭 등) — 저장소에 실수로 커밋되지 않게 루트의 엑셀 파일은 제외
/*.xlsx
