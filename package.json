{
  "name": "wiggle-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --import ./tests/harness/register.mjs --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local:init": "node --import ./tests/harness/register.mjs scripts/init-local-db.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:deployed": "node --import ./tests/harness/register.mjs scripts/check-deployed.mjs",
    "test:adapters": "node --test tests/turso-adapters.test.mjs tests/google-auth.test.mjs tests/save-split.test.mjs",
    "test:integration": "node --import ./tests/harness/register.mjs --test tests/classroom-entry-flow.test.mjs tests/student-join-atomic.test.mjs tests/student-profile-management.test.mjs tests/nickname-spacing.test.mjs tests/feedback-20260809.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "aws4fetch": "^1.0.20",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
